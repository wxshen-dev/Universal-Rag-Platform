# Docker Compose host ports
FRONTEND_PORT=8080
BACKEND_PORT=18080

# Application
APP_NAME=Universal RAG Platform
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=18080
APP_API_PREFIX=/api/v1
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
APP_API_KEY=change-me
INTERNAL_TOKEN=change-me
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRY_COUNT=1
HEALTH_PROBE_EXTERNAL_SERVICES=false
ALLOW_PROVIDER_FALLBACKS=true
INGESTION_MODE=sync
CORS_ALLOW_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:8080,http://localhost:8080
ENABLE_FOLDER_SOURCE=false
FOLDER_SOURCE_ALLOWED_ROOTS=

# Administration and authentication
ADMIN_MANUAL_USER_CREATION_ENABLED=false
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_USER_HEADERS=X-Authenticated-User,X-User-Id
ADMIN_AUTH_ALLOWED_ROLES=platform_admin
RETRIEVAL_AUTHENTICATED_IDENTITY_REQUIRED=false
AUTH_SESSION_ENABLED=false
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=3600
AUTH_SESSION_ISSUER=knowledge-base-core
TRUSTED_IDENTITY_HEADER_ENABLED=false
TRUSTED_IDENTITY_USER_HEADERS=X-Authenticated-User,X-User-Id
TRUSTED_IDENTITY_EXTERNAL_SOURCE_HEADERS=X-Identity-Source,X-Auth-Issuer
TRUSTED_IDENTITY_EXTERNAL_ID_HEADERS=X-Identity-External-Id,X-Auth-Subject
EVALUATION_RETRIEVAL_USER_ID=evaluation-service

# Permission checking: none or plugin
PERMISSION_MODE=none
PERMISSION_PLUGIN=app.permissions.noop.NoOpPermissionChecker

# PostgreSQL. Compose uses the POSTGRES_* values and connects through the
# internal service name automatically. DATABASE_URL is useful for local runs.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Local application storage
STORAGE_ROOT=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SAMPLE_DATA_DIR=./data/samples

# Vector store. local works without an external service.
VECTOR_STORE_PROVIDER=local
ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION=oa_rag_chunks

# Embedding provider (optional when fallbacks are enabled)
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=2560

# LLM provider (optional when fallbacks are enabled)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.1

# Reranking provider (optional)
RERANK_ENABLED=false
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=

# Dify integration (optional)
DIFY_BASE_URL=http://127.0.0.1:8000
DIFY_APP_KEY=
DIFY_RETRIEVAL_USER_ID=dify-external

# Image recognition: paddle_ocr or multimodal (optional)
IMAGE_RECOGNITION_PROVIDER=paddle_ocr
PADDLE_OCR_TOKEN=
MULTIMODAL_API_BASE=
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=
IMAGE_RECOGNITION_TIMEOUT=30
IMAGE_RECOGNITION_BATCH_SIZE=5
